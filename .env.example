# ─────────────────────────────────────────────────────────────────────────────
# Orbium – Environment Configuration Template
# Copy this file to .env and fill in values before running docker-compose.
# The .env file is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=orbium
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=orbium_db

# ── Backend ───────────────────────────────────────────────────────────────────
# Full SQLAlchemy connection string – must match the values above.
# development | production
BACKEND_ENV=development

# ── Frontend ──────────────────────────────────────────────────────────────────
# API base path as seen by the browser. /api is correct when Nginx is used.
VITE_API_URL=/api

# development | production
VITE_ENV=development

# ── Nginx ─────────────────────────────────────────────────────────────────────
# Host port mapped to Nginx container port 80.
NGINX_PORT=80
